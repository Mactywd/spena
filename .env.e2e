# Credenziali dello stack end-to-end, usa e getta. Non protegge niente: la password
# è la parola «test» e l'hash qui sotto è in git, quindi chiunque legge il repo può
# entrare in uno stack avviato con questo file. Esiste perché il percorso
# end-to-end deve poter fare l'accesso, e il .env dello sviluppatore contiene
# l'hash della sua password vera, che nessun test può conoscere.
#
# Si usa solo così, in un progetto Compose separato che si distrugge alla fine:
#   docker compose -p spena-e2e -f docker-compose.yml -f docker-compose.e2e.yml up -d --build
#
# L'hash è di «test», generato con app.core.security.hash_password.
APP_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$+9+l5uoYPuvoBpd3m/7EQQ$fUbczQ5SpDPp8cc7pmSWULEYOPyazhm/nsq114DlgUw
SESSION_SECRET=segreto-usa-e-getta-del-percorso-end-to-end
# `local` scaricherebbe un modello sentence-transformers da internet al primo
# avvio: la suite non tocca la rete, e la ricerca testuale basta a questo percorso.
EMBEDDING_BACKEND=fake
# Lo stack e2e gira su http://localhost: un cookie `Secure` non verrebbe mai
# rimandato dal browser e l'accesso sembrerebbe riuscito senza esserlo.
COOKIE_SECURE=false
# Il modello linguistico, chiuso. Il `.env` dello sviluppatore porta la chiave vera di
# OpenRouter, e per le chiavi ripetute vince l'ultimo `env_file` (questo): vuota, ogni
# chiamata al modello che sfugga a uno stub si ferma su `LlmUnavailable` — un 503 e il
# ripiego a mano — invece di spendere. Nessuna prova della suite chiama il modello vero.
OPENROUTER_API_KEY=
# Il contrassegno dello stack usa e getta: `backend/tests/e2e_import_review.py` scrive e
# cancella nel database, e si rifiuta di partire dove questa riga non c'è.
SPENA_E2E=1
