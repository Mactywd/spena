POSTGRES_USER=spena
POSTGRES_PASSWORD=spena
POSTGRES_DB=spena
# Obbligatoria e senza default: generala con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Lasciata vuota (o al valore di esempio), l'applicazione rifiuta di partire.
SESSION_SECRET=
APP_PASSWORD_HASH=
# In produzione va `true`: il cookie di sessione viaggia solo su HTTPS. Resta
# `false` in sviluppo, dove si serve anche su http://localhost e un cookie
# `Secure` non verrebbe mai rimandato dal browser — si entrerebbe e subito dopo
# ogni chiamata risponderebbe 401. docker-compose.prod.yml lo impone comunque.
COOKIE_SECURE=false
ANTHROPIC_API_KEY=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ENDPOINT=
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=3
# Solo per il deploy (docker-compose.prod.yml): il nome di host su cui Traefik
# pubblica l'app. In locale non serve e resta commentata.
# SPENA_HOST=spena.example.com
