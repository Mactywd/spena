POSTGRES_USER=spena
POSTGRES_PASSWORD=spena
POSTGRES_DB=spena
# Obbligatoria e senza default: generala con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Lasciata vuota (o al valore di esempio), l'applicazione rifiuta di partire.
SESSION_SECRET=
APP_PASSWORD_HASH=
# In produzione va `true`: il cookie di sessione viaggia solo su HTTPS. Resta
# `false` in sviluppo, dove si serve anche su http://localhost e un cookie
# `Secure` non verrebbe mai rimandato dal browser — si entrerebbe e subito dopo
# ogni chiamata risponderebbe 401. docker-compose.prod.yml lo impone comunque.
COOKIE_SECURE=false
ANTHROPIC_API_KEY=
# `local` usa sentence-transformers dentro al container, che però l'immagine
# installa solo con INSTALL_EMBEDDINGS=1 (sotto). Senza, ogni tentativo di calcolare
# un vettore degrada alla ricerca testuale e il backend lo scrive nei log al primo
# uso: è la degradazione prevista dalla spec §11, non un guasto.
EMBEDDING_BACKEND=local
# Cambiandolo va rimisurata SEMANTIC_MAX_DISTANCE in
# backend/app/services/recipe_search.py: la scala delle distanze è una proprietà del
# modello, e la soglia è misurata su questo. Finché non è rimisurata, il backend
# rinuncia alla metà semantica e lo scrive nei log, invece di applicare a un modello
# nuovo un numero che vale per un altro.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ENDPOINT=
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=3
# Argomento di build, non variabile d'ambiente: a 1 l'immagine del backend installa
# l'extra `embeddings` (sentence-transformers, e con lui torch: GB, non i 500 MB
# stimati dalla spec §5) e la ricerca semantica funziona. A 0 l'immagine pesa 233 MB
# e la ricerca resta quella testuale su pg_trgm. Cambiare qui e ricostruire:
# `docker compose up -d --build`.
INSTALL_EMBEDDINGS=0
# Solo per il deploy (docker-compose.prod.yml): il nome di host su cui Traefik
# pubblica l'app. In locale non serve e resta commentata.
# SPENA_HOST=spena.example.com
